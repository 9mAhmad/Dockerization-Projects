# relevant for application.properties
SERVER_PORT=8080
MYSQL_HOST=mysql 
MYSQL_PORT=3306 # Not used in dockerfile. If host is 'mysql' then 3306 but if host is 'localhost' then host port e.g. 5005
MYSQL_DBNAME=ecommjava
MYSQL_USER=root # we are using 'root', security is not priority
MYSQL_PASSWORD=rootpassword

# relevant for docker
MYSQL_ROOT_PASSWORD=rootpassword # this is for reference in docker-compose
# MYSQL_DBNAME=ecommjava

# "jdbc:mysql://${MYSQL_HOST:host.docker.internal}:${MYSQL_PORT}/${MYSQL_DBNAME:ecommjava}?createDatabaseIfNotExist=true"

